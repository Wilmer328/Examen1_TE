# Copie este archivo como .env y complete los valores. NUNCA versione .env.

# --- SQL Server ---
SQL_SERVER=.\SQLEXPRESS
# windows = autenticación integrada (desarrollo) | sql = cuentas técnicas de mínimo privilegio
SQL_AUTH=windows
ODBC_DRIVER=ODBC Driver 18 for SQL Server
SQL_ENCRYPT=no
SQL_TRUST_CERT=yes
DB_SOURCE=WideWorldImporters
DB_STAGING=WWI_Staging
DB_DW=WWI_DW
# Solo para docker-compose (contraseña del usuario sa del contenedor)
MSSQL_SA_PASSWORD=
ETL_DB_USER=etl_user
ETL_DB_PASSWORD=
API_DB_USER=api_user
API_DB_PASSWORD=

# --- ETL ---
EXTRACT_OVERLAP_MINUTES=5
ETL_MAX_RETRIES=3
ETL_BATCH_SIZE=5000

# --- API ---
# Genere uno con: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# usuario:clave:rol separados por coma (roles: analyst, admin). Cambie las claves.
APP_USERS=analista:CAMBIAR:analyst,admin:CAMBIAR:admin
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- IA generativa (Claude / Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=medium
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_RATE_PER_MINUTE=6

# --- Notificaciones (si SMTP_HOST está vacío, los correos se guardan en notifications/outbox como entrega SIMULADA) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@plataforma.local
ALERT_EMAIL_TO=analista@plataforma.local
ALERT_DROP_THRESHOLD=0.15
ALERT_ML_THRESHOLD=0.80
